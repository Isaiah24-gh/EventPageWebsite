{
  "name": "eventhub",
  "version": "1.0.0",
  "description": "EventHub — Local Events Discovery Website (Express/EJS/MySQL)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node database/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:views": "node scripts/check-ejs.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "ci": "npm run lint && npm run check:views && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "method-override": "^3.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  }
}
