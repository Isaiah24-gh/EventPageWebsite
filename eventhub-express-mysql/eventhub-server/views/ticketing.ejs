views/ticketing.ejs
<%- include('partials/header', { title, pageCss }) %>

<section class="section">
  <div class="container" style="max-width:640px;">
    <p class="eyebrow">Feature 6 · Ticketing</p>
    <h1>Get your tickets</h1>
    <p style="color:var(--ink-soft);margin-bottom:28px;">Complete your ticket purchase securely via our integrated payment API gateway.</p>

    <% if (!event) { %>
      <div class="empty-state">
        <h3>No event selected</h3>
        <p>Head back and choose an event to get tickets for. <a href="/">Browse Events</a></p>
      </div>
    <% } else { %>
      <% const priceLabel = event.price > 0 ? `$${Number(event.price).toFixed(2)}` : 'Free'; %>

      <div class="ticket-summary">
        <div class="ticket-summary-top">
          <span class="event-card-tag"><%= event.category %></span>
          <h2 style="margin:8px 0 4px 0;"><%= event.title %></h2>
          <p style="color:var(--ink-soft);margin:0;">
            <%= new Date(event.event_date).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
            · <%= event.event_time.slice(0,5) %> · <%= event.venue %>
          </p>
        </div>
        <div class="ticket-summary-divider"></div>
        <div class="ticket-summary-bottom">
          <div>
            <div class="ticket-row"><span>Quantity</span><span id="qty-display">1 ticket</span></div>
            <div class="ticket-row"><span>Price per ticket</span><span><%= priceLabel %></span></div>
          </div>
          <div style="text-align:right;">
            <p style="font-family:var(--font-label);font-size:0.78rem;color:var(--ink-soft);margin:0;">Total</p>
            <p id="total-display" style="font-family:var(--font-display);font-size:1.4rem;margin:0;" data-price="<%= event.price %>"><%= priceLabel %></p>
          </div>
        </div>
      </div>

      <form id="payment-form" action="/ticketing/checkout" method="POST" style="margin-top: 24px;">
        <input type="hidden" name="eventId" id="event-id-input" value="<%= event.id %>">

        <div class="field" style="max-width:200px; margin-bottom: 20px;">
          <label for="qty-input">Number of tickets</label>
          <input type="number" id="qty-input" name="quantity" min="1" max="10" value="1" required>
        </div>

        <!-- MOCK CREDIT CARD FORM FIELDS -->
        <div class="payment-details" style="border: 1px solid var(--border-color, #ccc); padding: 20px; border-radius: 8px; margin-bottom: 20px;">
          <h3 style="margin-top: 0; margin-bottom: 16px;">Card Information</h3>
          
          <div class="field" style="margin-bottom: 12px;">
            <label for="card-number">Card Number</label>
            <input type="text" id="card-number" placeholder="4111 2222 3333 4444" minlength="16" maxlength="19" required>
          </div>

          <div style="display: flex; gap: 16px;">
            <div class="field" style="flex: 1;">
              <label for="card-expiry">Expiry Date</label>
              <input type="text" id="card-expiry" placeholder="MM/YY" maxlength="5" required>
            </div>
            <div class="field" style="flex: 1;">
              <label for="card-cvv">CVV</label>
              <input type="text" id="card-cvv" placeholder="123" minlength="3" maxlength="4" required>
            </div>
          </div>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-accent btn-block">
          Authorize & Pay Securely →
        </button>
      </form>

    <% } %>
  </div>
</section>

<%- include('partials/footer') %>