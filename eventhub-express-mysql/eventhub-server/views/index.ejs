<%- include('partials/header', { title, active }) %>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Student Activities · Fandom Meets · Flea &amp; Warehouse Sales</p>
    <h1>Find what's happening<br>near you, this week.</h1>
    <p style="max-width:530px;color:var(--ink-soft)">Browse pop-ups, hobby gatherings, and campus events in one place.</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <form id="filter-form" method="GET" action="/" class="card" style="margin-bottom:32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;align-items:end;">
      <div class="field" style="margin-bottom:0;">
        <label for="f-search">Search</label>
        <input type="text" id="f-search" name="search" placeholder="Search events…" value="<%= filters.search %>">
      </div>
      <div class="field" style="margin-bottom:0;">
        <label for="f-category">Category</label>
        <select id="f-category" name="category" onchange="this.form.submit()">
          <option value="">All categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="field" style="margin-bottom:0;">
        <label for="f-date">Date</label>
        <input type="date" id="f-date" name="date" value="<%= filters.date %>" onchange="this.form.submit()">
      </div>
      <div class="field" style="margin-bottom:0;">
        <label for="f-price">Price</label>
        <select id="f-price" name="price" onchange="this.form.submit()">
          <option value="">Any price</option>
          <option value="free" <%= filters.price === 'free' ? 'selected' : '' %>>Free only</option>
          <option value="paid" <%= filters.price === 'paid' ? 'selected' : '' %>>Paid only</option>
        </select>
      </div>
      <div class="field" style="margin-bottom:0;">
        <button type="submit" class="btn btn-block">Search</button>
      </div>
    </form>

    <div class="section-title">
      <h2>Upcoming events</h2>
      <span class="badge"><%= events.length %> event<%= events.length === 1 ? '' : 's' %></span>
    </div>

    <% if (events.length) { %>
      <div class="event-grid">
        <% events.forEach(evt => { %>
          <%- include('partials/event-card', { evt, href: `/events/${evt.id}` }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3>No events match your filters</h3>
        <p>Try clearing a filter or searching a different keyword.</p>
      </div>
    <% } %>

  </div>
</section>

<%- include('partials/footer') %>
