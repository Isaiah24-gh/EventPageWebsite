<%
  const _date = new Date(evt.event_date);
  const _month = _date.toLocaleDateString('en-SG', { month: 'short', timeZone: 'UTC' }).toUpperCase();
  const _day = _date.getUTCDate();
  const _priceLabel = evt.price > 0 ? `$${Number(evt.price).toFixed(2)}` : 'Free';
%>
<a class="event-card" href="<%= href %>">
  <div class="event-card-date">
    <span class="month"><%= _month %></span>
    <span class="day"><%= _day %></span>
  </div>
  <div class="event-card-body">
    <span class="event-card-tag"><%= evt.category %></span>
    <h3 class="event-card-title"><%= evt.title %></h3>
    <p class="event-card-meta"><%= evt.venue %> · <%= evt.event_time.slice(0,5) %> · <%= _priceLabel %></p>
  </div>
</a>
