<%- include('partials/header', { title, pageCss }) %>

<section class="section">
  <div class="container">
    <p class="eyebrow">Feature 2 · Account Webpage</p>

<div class="profile-header">
  <label class="avatar avatar-upload" for="avatar-input">
    <% if (profileUser.avatar_url) { %>
      <img src="<%= profileUser.avatar_url %>" alt="Profile picture">
    <% } else { %>
      <%= profileUser.name.charAt(0).toUpperCase() %>
    <% } %>
    <span class="avatar-edit-badge">Change</span>
  </label>

  <div>
    <h1 style="margin-bottom:2px;"><%= profileUser.name %></h1>
    <p style="color:var(--ink-soft);margin:0;"><%= profileUser.email %></p>
    <div style="display:flex;gap:6px;margin-top:6px;">
      <span class="badge"><%= profileUser.role %></span>
      <% if (profileUser.gender) { %>
        <span class="badge badge-marigold"><%= profileUser.gender %></span>
      <% } %>
    </div>
  </div>
</div>

<form id="profile-form" class="form-card" method="POST" action="/account/profile" enctype="multipart/form-data" style="max-width:480px;margin-bottom:40px;">
  <input type="file" id="avatar-input" name="avatar" accept="image/png,image/jpeg,image/webp" form="profile-form" hidden>

  <div class="field">
    <label for="gender">Preferred gender</label>
    <select id="gender" name="gender">
      <option value="" <%= !profileUser.gender ? 'selected' : '' %>>Prefer not to say</option>
      <option value="male" <%= profileUser.gender === 'male' ? 'selected' : '' %>>Male</option>
      <option value="female" <%= profileUser.gender === 'female' ? 'selected' : '' %>>Female</option>
    </select>
  </div>

  <div class="field">
    <div class="bio-label-row">
      <label for="bio">Bio</label>
      <button type="button" id="edit-bio-btn" class="btn-link">Edit</button>
    </div>

    <p id="bio-display" class="bio-display"><%= profileUser.bio || 'No bio yet. Click edit to add one.' %></p>

    <div id="bio-edit-wrap" class="bio-edit-wrap" hidden>
      <textarea id="bio" name="bio" rows="3" maxlength="500" placeholder="Tell people a bit about yourself..."><%= profileUser.bio || '' %></textarea>
      <div class="bio-edit-actions">
        <button type="submit" class="btn btn-sm">Save</button>
        <button type="button" id="cancel-bio-btn" class="btn btn-sm btn-secondary">Cancel</button>
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-block">Save Profile</button>
</form>

    <div class="section-title">
      <h2>Saved favourites</h2>
    </div>

    <% if (favourites.length) { %>
      <div class="event-grid">
        <% favourites.forEach(evt => { %>
          <%- include('partials/event-card', { evt, href: `/events/${evt.id}` }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3>No saved events yet</h3>
        <p>Browse events and tap "Save" to add them here.</p>
        <a class="btn btn-sm" href="/" style="margin-top:12px;">Browse Events</a>
      </div>
    <% } %>

    <% if (currentUser.role === 'organiser') { %>
      <div style="margin-top:48px;">
        <div class="section-title">
          <h2>My listings</h2>
          <button class="btn btn-sm" id="new-listing-btn">+ New Listing</button>
        </div>

        <form id="listing-form" class="form-card" method="POST" action="/account/listings" style="max-width:100%;display:none;margin-bottom:24px;">
          <div class="field"><label for="title">Event title</label><input type="text" id="title" name="title" required></div>
          <div class="field"><label for="category">Category</label><input type="text" id="category" name="category" placeholder="e.g. Flea Market" required></div>
          <div class="field"><label for="eventDate">Date</label><input type="date" id="eventDate" name="eventDate" required></div>
          <div class="field"><label for="eventTime">Time</label><input type="time" id="eventTime" name="eventTime" required></div>
          <div class="field"><label for="venue">Venue</label><input type="text" id="venue" name="venue" required></div>
          <div class="field"><label for="description">Short description</label><textarea id="description" name="description" rows="3" required></textarea></div>
          <div class="field"><label for="externalUrl">Registration link (your website / social page)</label><input type="url" id="externalUrl" name="externalUrl" placeholder="https://" required></div>
          <button type="submit" class="btn btn-block">Publish Listing</button>
        </form>

        <% if (listings.length) { %>
          <div class="event-grid">
            <% listings.forEach(evt => { %>
              <div style="position:relative;">
                <%- include('partials/event-card', { evt, href: `/events/${evt.id}` }) %>
                <span class="status-pill status-<%= evt.status %>" style="position:absolute;top:8px;right:8px;"><%= evt.status %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <h3>No listings yet</h3>
            <p>Create your first event listing above.</p>
          </div>
        <% } %>
      </div>
    <% } %>

  </div>
</section>

<%- include('partials/footer') %>