<%- include('../partials/header', { title, pageCss }) %>

<section class="section">
  <div class="container">
    <p class="eyebrow">Feature 1 · Account Creation</p>
    <h1>Forgot your password?</h1>
    <p style="max-width:480px;color:var(--ink-soft);margin-bottom:32px;">Enter the email address on your EventHub account and we'll send you a link to set a new password.</p>

    <form class="form-card" method="POST" action="/forgot-password">
      <div class="field">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" required autocomplete="email" autofocus>
        <p class="field-hint">The link works for <%= expiryMinutes %> minutes, then it stops working.</p>
      </div>
      <button type="submit" class="btn btn-block">Send Reset Link</button>
      <p style="text-align:center;font-size:0.85rem;color:var(--ink-soft);margin:16px 0 0 0;">
        Remembered it? <a href="/login" style="color:var(--ink);font-weight:600;">Back to log in</a>
      </p>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
